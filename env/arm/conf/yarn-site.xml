<?xml version="1.0"?>
<!--
  Deployed to: hive_arm container (192.168.0.181) : /opt/hadoop/etc/hadoop/yarn-site.xml
  Date: 2026-07-30

  Purpose: the container runs NameNode + DataNode + HMS + HiveServer2 but NO YARN
  ResourceManager. Hadoop's TokenCache still calls Master.getMasterPrincipal() when
  security is enabled, and without yarn.resourcemanager.principal it fails with:
      java.io.IOException: Can't get Master Kerberos principal for use as renewer
  Setting the principal supplies the delegation-token renewer name; the RM itself is
  never contacted (MR runs in-process, see mapred-site.xml -> mapreduce.framework.name=local).

  Note: principal yarn/hive-arm@HIVE_ARM.TEST was also created in the container KDC
  via: kadmin.local -q "addprinc -randkey yarn/hive-arm@HIVE_ARM.TEST"
-->
<configuration>
  <property>
    <name>yarn.resourcemanager.principal</name>
    <value>yarn/hive-arm@HIVE_ARM.TEST</value>
  </property>
  <property>
    <name>yarn.nodemanager.principal</name>
    <value>yarn/hive-arm@HIVE_ARM.TEST</value>
  </property>
  <property>
    <name>yarn.resourcemanager.hostname</name>
    <value>hive-arm</value>
  </property>
  <property>
    <name>yarn.resourcemanager.address</name>
    <value>hive-arm:8032</value>
  </property>
  <property>
    <name>yarn.nodemanager.aux-services</name>
    <value>mapreduce_shuffle</value>
  </property>
</configuration>
